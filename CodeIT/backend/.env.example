# ==================================================
# CodeIT Backend Environment Variables (Express + Judge0)
# ==================================================

# Server Configuration
# PORT is automatically provided by Render in production. Default is 3000 locally.
PORT=3000

# Frontend URL for CORS (Comma-separated for multiple origins e.g. http://localhost:5173,https://codeit.vercel.app)
FRONTEND_URL=http://localhost:5173

# Database & Authentication Configuration
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Optional custom directory for problem JSON files (auto-resolved relative to backend utils by default)
# PROBLEMS_DIR=../../src/problems

# Judge0 API Configuration
# Public unauthenticated Judge0 CE instance: https://ce.judge0.com
# For RapidAPI or self-hosted instance, set JUDGE0_API_URL and optional credentials below
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Configurable Language IDs (Standard Judge0 CE)
# C++ (GCC 9.2.0): 54 | Java (OpenJDK 13.0.1): 62 | Python (3.8.1): 71
JUDGE0_CPP_LANGUAGE_ID=54
JUDGE0_JAVA_LANGUAGE_ID=62
JUDGE0_PYTHON_LANGUAGE_ID=71

# Limits & Polling Settings
JUDGE0_CPU_TIME_LIMIT=3.0
JUDGE0_MEMORY_LIMIT=128000
JUDGE0_MAX_POLL_ATTEMPTS=20
JUDGE0_POLL_INTERVAL_MS=500
