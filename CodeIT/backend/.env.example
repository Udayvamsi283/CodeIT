# ==================================================
# CodeIT Backend Environment Variables
# ==================================================

# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# Judge0 API Configuration
# For public unauthenticated instance: https://ce.judge0.com
# For RapidAPI: https://judge0-ce.p.rapidapi.com (with JUDGE0_API_KEY and JUDGE0_API_HOST)
# For self-hosted: http://localhost:2358
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Judge0 Language IDs (Configurable - check your Judge0 instance /languages endpoint)
# C++ (GCC 9.2.0): 54 or (GCC 14.1.0): 105
JUDGE0_CPP_LANGUAGE_ID=54
# Java (OpenJDK 13.0.1): 62 or (JDK 17.0.6): 91
JUDGE0_JAVA_LANGUAGE_ID=62
# Python (3.8.1): 71 or (3.11.2): 92
JUDGE0_PYTHON_LANGUAGE_ID=71

# Resource Limits & Polling
JUDGE0_CPU_TIME_LIMIT=3.0
JUDGE0_MEMORY_LIMIT=128000
JUDGE0_MAX_POLL_ATTEMPTS=20
JUDGE0_POLL_INTERVAL_MS=500
