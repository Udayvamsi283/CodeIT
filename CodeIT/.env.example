# ==================================================
# CodeIT Frontend Environment Variables (Vite)
# ==================================================

# Frontend API Base URL
# Local development: Leave empty (or omit) to use Vite dev proxy to http://localhost:3000, or explicitly set to http://localhost:3000
# Production (Vercel): Leave empty (or omit) so API requests use relative paths (/api/*) and proxy through Vercel rewrites to Render
VITE_API_URL=
